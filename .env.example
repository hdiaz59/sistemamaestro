# Configuración de URL del Sistema Maestro
SISTEMA_MAESTRO_URL=https://sistemamaestro.mineducacion.gov.co/SistemaMaestro/busquedaVacantes.xhtml

# Base de datos SQLite
DATABASE_URL=sqlite:///data/sistema_maestro.db

# Opciones del scraper
HEADLESS=true
TIMEOUT=30000
MAX_PAGES=100
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36

# Notificaciones por Correo (Opcional)
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASSWORD=tu_contraseña_de_aplicacion
NOTIFICATION_RECIPIENTS=destinatario1@gmail.com,destinatario2@gmail.com

# Notificaciones por Telegram (Opcional)
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Nivel de log (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
